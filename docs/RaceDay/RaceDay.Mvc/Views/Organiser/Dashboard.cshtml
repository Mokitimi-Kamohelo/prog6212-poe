@model RaceDay.Mvc.ViewModels.OrganiserDashboardViewModel

@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-4">
    <h1>Organiser Dashboard</h1>
    <p class="text-muted">Manage your RaceDay events.</p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="row g-3 my-4">

        <div class="col-md-3">
            <div class="card p-3">
                <h6>Total Events</h6>
                <h2>@Model.TotalEvents</h2>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3">
                <h6>Upcoming Events</h6>
                <h2>@Model.UpcomingEvents</h2>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3">
                <h6>Participants</h6>
                <h2>@Model.TotalParticipants</h2>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3">
                <h6>Completed Results</h6>
                <h2>@Model.CompletedResults</h2>
            </div>
        </div>

    </div>

    <div class="mb-4">
        <a asp-action="CreateEvent"
           class="btn btn-primary">
            + Create Event
        </a>

        <a asp-action="MyEvents"
           class="btn btn-outline-secondary">
            My Events
        </a>
    </div>

    <h3>Upcoming Events</h3>

    @if (!Model.Events.Any())
    {
        <p>You haven't created any events yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Participants</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.Events
                        .OrderBy(e => e.EventDate))
                    {
                        <tr>
                            <td>@item.EventName</td>
                            <td>@item.EventDate</td>
                            <td>@item.Location</td>
                            <td>@item.EnrolmentCount</td>
                            <td>
                                <a asp-action="ManageEvent"
                                   asp-route-id="@item.EventId"
                                   class="btn btn-sm btn-primary">
                                    Manage
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>