@model List<RaceDay.Mvc.Models.Api.ResultApiModel>

@{
    ViewData["Title"] = "My Results";
}

<h1 class="fw-bold">My Results</h1>

<p class="text-muted mb-4">

    Your race history and achievements.

</p>

@if (Model.Count == 0)
{
    <div class="card shadow-sm">

        <div class="card-body text-center py-5">

            <h4>No results available yet.</h4>

            <p class="text-muted">

                Results will appear here once Organisers
                publish your race results.

            </p>

            <a asp-controller="Events"
               asp-action="Index"
               class="btn btn-warning">

                Browse Events

            </a>

        </div>

    </div>
}
else
{
    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover">

                    <thead class="table-dark">

                        <tr>
                            <th>Event</th>
                            <th>Date</th>
                            <th>Category</th>
                            <th>Finish Time</th>
                            <th>Position</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var result in Model.OrderByDescending(r => r.EventDate))
                        {
                            <tr>

                                <td class="fw-semibold">

                                    @result.EventName

                                </td>

                                <td>

                                    @result.EventDate.ToString("dd MMM yyyy")

                                </td>

                                <td>

                                    @(result.CategoryName ?? "N/A")

                                </td>

                                <td>

                                    @if (result.FinishTime.HasValue)
                                    {
                                        @result.FinishTime.Value.ToString("HH:mm:ss")
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not recorded</span>
                                    }

                                </td>

                                <td>

                                    @if (result.FinishPosition.HasValue)
                                    {
                                        <span class="badge bg-success">

                                            @result.FinishPosition

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not recorded</span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>
}