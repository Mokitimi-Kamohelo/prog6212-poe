@model RaceDay.Mvc.Models.ViewModels.ApiStatusViewModel

@{
    ViewData["Title"] = "RaceDay";
}

<div class="container mt-5">

    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">RaceDay</h1>

        <p class="lead">
            Your running, walking and cycling events platform.
        </p>
    </div>

    <div class="card shadow-sm mx-auto" style="max-width: 700px;">

        <div class="card-header">
            <h4 class="mb-0">System Connectivity</h4>
        </div>

        <div class="card-body">

            @if (Model.ApiConnected)
            {
                <div class="alert alert-success">
                    <strong>Connected</strong>
                    <p class="mb-0">@Model.Message</p>
                </div>
            }
            else
            {
                <div class="alert alert-danger">
                    <strong>Connection Failed</strong>
                    <p class="mb-0">@Model.Message</p>
                </div>
            }

            <h5>API Response</h5>

            <pre class="bg-light p-3 rounded text-break">@Model.ApiResponse</pre>

            <button class="btn btn-primary"
                    onclick="location.reload()">
                Test Connection Again
            </button>

        </div>
    </div>

</div>