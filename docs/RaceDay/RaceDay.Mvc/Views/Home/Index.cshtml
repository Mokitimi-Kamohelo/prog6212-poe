@model RaceDay.Mvc.Models.ViewModels.ApiStatusViewModel

@using RaceDay.Mvc.Services

@{
    ViewData["Title"] = "Home";

    var loggedIn = Context.Session.GetString(
        SessionKeys.JwtToken) != null;

    var role = Context.Session.GetString(
        SessionKeys.Role);
}

<div class="p-4 p-md-5 mb-4 bg-dark text-white rounded-3">

    <div class="container-fluid py-3">

        <h1 class="display-4 fw-bold">

            RaceDay

        </h1>

        <p class="lead">

            Every race starts with a single step.

            Discover events, challenge yourself,
            and track your achievements.

        </p>

        @if (!loggedIn)
        {
            <a asp-controller="Auth"
               asp-action="Register"
               class="btn btn-warning btn-lg me-2">

                Get Started

            </a>

            <a asp-controller="Auth"
               asp-action="Login"
               class="btn btn-outline-light btn-lg">

                Login

            </a>
        }
        else
        {
            <h4 class="mt-3">

                Welcome,
                @Context.Session.GetString(SessionKeys.FirstName)!

            </h4>

            <p>

                You are logged in as
                <strong>@role</strong>.

            </p>
        }

    </div>

</div>

<div class="row g-4">

    <div class="col-md-6">

        <div class="card h-100 shadow-sm">

            <div class="card-body">

                <h4 class="card-title">

                    Discover Events

                </h4>

                <p class="card-text">

                    Find upcoming running, walking and
                    cycling events.

                </p>

            </div>

        </div>

    </div>

    <div class="col-md-6">

        <div class="card h-100 shadow-sm">

            <div class="card-body">

                <h4 class="card-title">

                    Track Your Progress

                </h4>

                <p class="card-text">

                    Keep track of your enrolments,
                    achievements and results.

                </p>

            </div>

        </div>

    </div>

</div>

<hr class="my-4" />

<h4>System Status</h4>

@if (Model.ApiConnected)
{
    <div class="alert alert-success">

        <strong>API Online</strong>

        <p class="mb-0">

            The RaceDay MVC application is communicating
            with the backend API.

        </p>

    </div>
}
else
{
    <div class="alert alert-warning">

        <strong>API Connection Issue</strong>

        <p class="mb-0">

            @Model.Message

        </p>

    </div>
}